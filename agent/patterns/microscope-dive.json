    ],
    "parameters": [
      {
        "name": "镜头插值",
        "value": "film/film.js:key / KEYS / camAt，以复数相似变换M^u围绕固定点插值，视野68000→9200→2700→345µm，roll与变焦同步。"
      },
      {
        "name": "影像层级",
        "value": "film/film.js:plateAlpha / activeLevel，ORDER=a8/a4/a2/c1/c05/c025，FULL=1.45、NONE=2.2像素密度阈值。"
