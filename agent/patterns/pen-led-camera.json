    "id": "pen-led-camera",
    "order": 61,
    "title": "笔尖牵引镜头与停笔节奏",
    "types": [
      "camera",
      "rhythm"
    ],
    "carriers": [
      "video"
    ],
    "orients": [
      "landscape"
    ],
    "summary": "镜头跟随笔尖，转角减速、停笔时刹停、续笔后追赶，最后拉远为完整海报。",
    "mechanism": "笔尖在转角密集处按加权路径长度减速，并在重复标记处停笔；镜头以高斯采样跟随，随停笔刹停与续笔追赶，再把焦点交给标志和海报。",
    "trigger": "笔尖进入转角、重复路径标记、标志聚焦和海报拉远节点时。",
    "effect": "描绘、镜头和笔触声音共享停顿节奏，局部跟随过渡为标志与完整海报的构图。",
    "timing": [
      {
        "name": "原片重放区间",
        "value": "0–10秒，1倍速；巧思时长10秒。"
      },
      {
        "name": "转角减速",
        "value": "const KCORN = 9; (1 + KCORN * Math.min(CORN[i], 0.3))。"
      },
      {
        "name": "停笔区间",
        "value": "2.083–2.233、3.5–3.65、4.75–4.9秒。"
      },
      {
        "name": "镜头刹停追赶",
        "value": "const HA = 0.133, HR = 0.5; const dt = k * 0.05；sigma: 0.3；lead: 0.08；hook lag: 0.067。"
      },
      {
        "name": "焦点交接",
        "value": "logo_from: 6.0；logo_to: 7.3；poster_from: 7.8；poster_to: 9.0；end_push amount: 0.03。"
      },
      {
        "name": "笔触响度",
        "value": "env = np.clip(spd / 3000.0, 0, 1) ** 0.6 * (tt < T_END + 0.02)；env = filters.lpf(env.astype(np.float32), 30.0)。"
      }
    ],
    "useCases": [
      "笔尖跟随镜头",
      "连续路径的转角停顿",
      "从局部描绘拉远为海报"
    ],
    "avoid": [
      "竖屏重排",
      "片段边界无缝循环"
