  "id": "deck-deal-flyin",
  "pattern": {
    "id": "deck-deal-flyin",
    "order": 94,
    "title": "加速发牌飞入",
    "types": [
      "composition",
      "rhythm"
    ],
    "carriers": [
      "video"
    ],
    "orients": [
      "landscape"
    ],
    "summary": "26 张卡先在右上角堆成一叠做 3D 特写，拉远后按阅读顺序加速发牌，飞入网格各自的槽位。",
    "mechanism": "牌堆姿态带由 index 派生的微小错位与堆高；镜头先旋转特写牌堆再拉远露出页面；发牌按阅读顺序，第 k 张出发时刻 cue = DEAL_START + 4k − 0.0792k(k−1)，间隔从 4 帧缩到 0.2 帧。",
    "trigger": "字卡一结束，切入牌堆特写。",
    "effect": "发牌从从容到连成一片，用物理隐喻的加速度把一页卡片铺满。",
    "timing": [
      {
        "name": "片段",
        "value": "AIFL_SHOTS.table 的 275–375 帧，100/30 秒。"
      },
      {
        "name": "镜头阶段",
        "value": "CAM_KEYS：0→34 旋转特写，34→62 拉远，62→82→98 加速滚动。"
      },
      {
        "name": "发牌节奏",
        "value": "DEAL_START=36；cue=36+4*k-0.0792*k*(k-1)；飞行 cue→cue+8，归位 cue+8→cue+12。"
      }
    ],
    "parameters": [
      {
        "name": "牌堆",
        "value": "N_CARDS=26；PILE={x:1430,y:240}；STACK_STEP=3；pz=(26-k)*3。"
      },
      {
        "name": "确定性微偏",
        "value": "px=1430+(((k*7)%9)-4)*2；py=240+(((k*5)%7)-3)*2；protZ=((k*11)%7)-3。"
      },
      {
        "name": "飞行",
        "value": "HOVER_H=40；arc=sin(diveT*π)*90；DIVE_EASE=bezier(0.3,0,0.2,1)；SETTLE_EASE=bezier(0.3,0,0.25,1.15)。"
      }
    ],
    "sourceFiles": [
      "demos/cases/ink-press/film/src/aifl/live/SceneFlyIn.tsx"
    ],
    "locator": "SceneFlyIn / grid / DEAL_START / CAM_KEYS",
    "accessibility": {
      "reducedMotion": "减少动态时暂停在预览时刻，可手动播放和定位。",
      "keyboard": "空格播放或暂停，左右方向键定位，Shift加方向键跳到标记。"
    },
    "composition": {
      "role": "accent",
      "pairsWellWith": [
        "page-cam-25d",
