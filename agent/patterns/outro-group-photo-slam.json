    "summary": "虚焦后各页面元素组装成一张合影，铅印字标砸落，riser→impact→sparkle 的声音句式收尾，字标落定后停 1 秒。",
    "mechanism": "九个页面切片按 ELS.cue=4,7,10,13,16,19,22,25,28 从四周飞入，各用 12 帧带超调组装，合影层做吊臂推进并在字标出现时退后；字标按 round(42+i*1.8) 逐字砸落，8 帧内清晰落定；SFX 中 riser 帧 945（0.5）、impact 帧 980（0.55）、sparkle 帧 1005（0.3）。",
    "trigger": "字卡四结束后进入结尾。",
    "effect": "全片能量推到峰值，品牌字标落定并留出 1 秒静止。",
    "timing": [
      {
        "name": "片段",
        "value": "AIFL_SHOTS.outro：940–1085 帧，145/30 秒。"
      },
      {
        "name": "组装与砸落",
        "value": "ELS.cue=[4,7,10,13,16,19,22,25,28]，各飞行 12 帧；字标 delay=round(42+i*1.8)，各入场 8 帧。"
      },
      {
        "name": "声音句式",
        "value": "SFX：945 riser-cine.mp3 volume=0.5；980 impact-cine.mp3 volume=0.55；1005 sparkle.mp3 volume=0.3。"
      },
      {
        "name": "收尾",
        "value": "tag=68→80；fadeOut=duration-12→duration，即 133→145；字标完整后保留至少 30 帧。"
      }
    ],
    "parameters": [
      {
        "name": "超调与镜头",
        "value": "FLY_EASE=bezier(0.34,1.4,0.44,1)；CRANE_EASE=bezier(0.3,0,0.2,1)；camScale=1.06-0.06*craneT+0.035*pushT。"
      },
      {
        "name": "字标",
        "value": "wordmarkSize=148；translateY=(1-t)*28px；scale=1.35-0.35*t；blur=(1-t)*8px。"
      },
      {
        "name": "合影后退",
        "value": "recede=42→50；settledOpacity=opacity*(1-0.12*recede)；saturate=1-0.08*recede。"
      }
    ],
