  "id": "page-cam-25d",
  "pattern": {
    "id": "page-cam-25d",
    "order": 92,
    "title": "2.5D 页面相机",
    "types": [
      "camera"
    ],
    "carriers": [
      "video"
    ],
    "orients": [
      "landscape"
    ],
    "summary": "整页 2x 截图作为平面，关键帧插值相机位姿做 2.5D 运镜，CSS zoom 布局级放大保住小字清晰。",
    "mechanism": "页面截图是相机下的一个平面，关键帧 {frame, cx, cy, zoom, rotX, rotY, rotZ, persp} 插值得到每帧位姿；子元素按页面 CSS 像素定位，与 layout.json 同一坐标系；3D 模式用 CSS zoom 放大布局，不用 transform scale。",
    "trigger": "镜头内的关键帧依次到达。",
    "effect": "详情页从全景推到宏观特写，行元素在同一相机下逐条嵌入，文字在大倍率下仍清晰。",
    "timing": [
      {
        "name": "片段",
        "value": "AIFL_SHOTS.macro：465–565 帧，100/30 秒。"
      },
      {
        "name": "相机键",
        "value": "DETAIL_CAM：[0,cx=960,cy=300,zoom=1.1] → [75,cx=960,cy=760,zoom=1.0]。"
      },
      {
        "name": "行嵌入",
        "value": "cue=12+i*9，land=cue+12，patch 在 land+2 消失，seam 在 land+8 消失。"
      }
    ],
    "parameters": [
      {
        "name": "页面坐标",
        "value": "整页宽 1920 CSS px，pageH=layout.detail.pageH，children 与 live-layout.json 同坐标系。"
      },
      {
        "name": "布局放大",
        "value": "zoom；translate(960/zoom-cx,540/zoom-cy)，perspective=persp*zoom，默认 persp=1400。"
      },
      {
        "name": "缓动",
        "value": "PageCam：Easing.bezier(0.33,0,0.15,1)；FLY_EASE=Easing.bezier(0.3,0,0.25,1)。"
      }
    ],
    "sourceFiles": [
      "demos/cases/ink-press/film/src/aifl/live/PageCam.tsx",
      "demos/cases/ink-press/film/src/aifl/live/SceneDetail.tsx"
    ],
    "locator": "PageCam / CamKey / DETAIL_CAM / SceneDetail",
    "accessibility": {
      "reducedMotion": "减少动态时暂停在预览时刻，可手动播放和定位。",
      "keyboard": "空格播放或暂停，左右方向键定位，Shift加方向键跳到标记。"
    },
    "composition": {
      "role": "foundation",
      "pairsWellWith": [
        "spotlight-hero-card",
