  "pattern": {
    "id": "shape-wipe-transition",
    "order": 42,
    "title": "形状擦除转场",
    "types": [
      "transition"
    ],
    "carriers": [
      "video"
    ],
    "orients": [
      "landscape",
      "portrait"
    ],
    "summary": "重放通知气泡的预备形变，以及珊瑚彗星、薄荷胶囊和奶油半圆依次覆盖画面的转场。 形变片从主体位置向外扩张色域，并同步裁切同色装饰和字幕完成全屏换景。 综艺片用带滚动糖果条纹的不透明斜带扫过全屏，遮住前镜并露出下一镜。",
    "mechanism": "气泡预备后以彗星形、胶囊、半圆依次擦过全屏完成场景切换。 形变片的换景从主体在色域节点的位置出发，以扩张圆形与速度相关羽化边缘接管全屏。 综艺片用带滚动糖果条纹的不透明斜带扫过全屏，遮住前镜并露出下一镜。",
    "trigger": "气泡进入预备段，随后依次到达三段擦除与半圆砸落节点时。",
    "effect": "通知气泡从室内信息元素变成覆盖画面的形状，连续色场擦除接入下一场景。",
    "timing": [
      {
        "name": "气泡预备",
        "value": "144/30–150/30=4.800–5.000秒；sx乘1+.12*an，sy乘1-.18*an；上提段145/30=4.833秒起。"
      },
      {
        "name": "彗星气泡",
        "value": "150/30–160/30=5.000–5.333秒；圆半径58；k=exp(lerp(log(1.12),log(34),E.ioQ(u1)))；尾长84→204；旋转175*E.outC(u1)。"
      },
      {
        "name": "薄荷胶囊",
        "value": "154/30–163/30=5.133–5.433秒；3000×1500、rx750；k=exp(lerp(log(.03),0,E.ioQ(u2)))；rot=25*(1-E.outB(u2,1.6))。"
      },
      {
        "name": "奶油半圆",
        "value": "158/30–164/30=5.267–5.467秒；半径1700；y=-110-2300*(1-E.inQ(u3))+40*kick(tc,slam,3.5,.4)；sy=1-.06*kick；rot=7*(1-u3)。"
      },
      {
        "name": "总时长",
        "value": "9.49333s"
      },
      {
        "name": "主体扩张成色域",
        "value": "L43: const EB = bez(0.42, 0, 0.12, 1);；L428: const FEATHER = 0.4 * 0.5 / FPS;；L430: function circleReg(t, t0, t1, o, r0 = 40, ease = EB) { if (t < t0) return null; if (t >= t1) return 'full';"
      },
      {
        "name": "追加原片区间",
        "value": "mg-hanazi 原片 3.57–4.43 秒；const BW = 1900, bar = 90, dv = 8;\nconst c = lerp(2400, -2400, E.inOutSine(u));\ntranslate(540 960) rotate(-20)"
      }
    ],
    "useCases": [
