    "renderer": "gpu",
    "summary": "大章边界用五道错峰水彩笔刷横扫，边界前 0.3 秒盖住画面，边界后 0.3 秒揭开新章；章内由角色动作接镜。",
    "mechanism": "WIPES 只列 1.5、38.5、73.0、109.4 秒。drawWorld 在边界两侧各 WIPE_TR=.3 秒调用 wipe；五道有毛边与木炭排线的笔刷带略倾斜，先以 easeOut 从左盖满，再以 ease 向右拖出。两章在全盖住的中点切换。",
    "trigger": "歌曲时刻进入任一 WIPES 边界的前后 0.3 秒。",
    "effect": "新旧章节被同一笔刷横扫连接，色对随章界轮换；章内的咬合黑场、穿眼推进等动作继续各自接镜。",
    "timing": [
      {
        "name": "章界",
        "value": "film/src/timeline.js:11–12：WIPES=[1.5,38.5,73.0,109.4]；WIPE_TR=.3，单次共 .6 秒。"
      },
      {
        "name": "进出缓动",
        "value": "film/src/timeline.js:40/73–79：p=(t-(b-.3))/.6；p<.5 用 easeOut 盖住，p≥.5 用 ease 揭开。"
      },
      {
        "name": "重放区间",
        "value": "原片37.9–39.2秒、72.4–73.7秒，巧思总时长2.6秒。"
      }
    ],
    "parameters": [
      {
        "name": "笔刷带",
        "value": "film/src/timeline.js:74–78：n=5，bh=(H+420)/5+40；rotate(-.1)；错峰 d=[0,.14,.06,.18,.1]。"
      },
      {
        "name": "覆盖与质感",
        "value": "film/src/timeline.js:79–87：横向 -300→W+400；washOp=255，fillOp=70，bleed=.05，tex=.8，border=.6；charcoal hatch d=44、w=.8。"
      },
      {
        "name": "配色",
        "value": "film/src/timeline.js:72：clayDk/clay、indigo/violet、teal/sap、violet/rose，依次对应四个章界。"
      }
    ],
    "useCases": [
