  "pattern": {
    "id": "squash-stretch-bounce",
    "order": 40,
    "title": "预备、拉伸与压扁回弹",
    "types": [
      "rhythm"
    ],
    "carriers": [
      "video"
    ],
    "orients": [
      "landscape"
    ],
    "summary": "重放圆点落地、蓄力弹射与图标接力中的拉伸、压扁和回弹。逐帧火苗段追加醒来后的蹲压、拉长起跳、落地压扁与连续舞步。 液态片的液滴触地压扁回弹，冠状液臂长出后断成延迟飞出的次级液滴。",
    "mechanism": "圆点起跳前压缩，飞行中沿速度方向拉伸，落地时压扁再回弹，组成从预备到落定的一整套弹跳形变。逐帧火苗按24fps曝光表进行蹲压、拉长起跳与落地压扁回弹，再接连续小跳与转身。 液态片沿速度拉伸的液滴在触地时压扁回弹，冠状液臂变细断裂，次级液滴延迟飞出。",
    "trigger": "圆点开始下落、进入起跳预备或到达落地节点时。",
    "effect": "圆点的横纵尺寸、旋转和接触位置随起跳、速度与碰撞阶段联动。",
    "timing": [
      {
        "name": "下落拉伸",
        "value": "g=2040；a=-0.12；R0=74；k=min(g*(t-a)/1500,1)*.16；sy=1+k，sx=1/(1+k)。"
      },
      {
        "name": "首次触地",
        "value": "15/30=.500秒；3帧压缩sy=1-.4*sin(πu)、sx=1+.36*sin(πu)；回跳高78。"
      },
      {
        "name": "再次触地",
        "value": "24/30=.800秒；2.5帧压缩幅.2/.18。"
      },
      {
        "name": "起跳预备",
        "value": "27/30–31/30=.900–1.033秒；sy*=1-.3*a，sx*=1+.24*a；y=GY-R0*sy。"
      },
      {
        "name": "弧线弹射",
        "value": "31/30–40/30=1.033–1.333秒；E.outQt；dt=1/240；st=clamp(speed/5200)*.42；sx=1+st，sy=1/(1+st)。"
      },
      {
        "name": "连续接力预备",
        "value": "a/o=171/173、185/188、200/203帧；an=E.outQ(inv(a,o,t))；sy乘1-.3*an，sx乘1+.2*an。"
      },
      {
        "name": "连续接力落地",
        "value": "180/30=6.000、195/30=6.500秒；land=kick(t,上一落地,3.5,.4)；sy乘1-.22*land，sx乘1+.2*land；y补偿R_D*(1-sy)。"
      },
      {
        "name": "火苗跳跃形变",
        "value": "24fps；s.sy=[2.6,1.3,1.18,1.06,1.0,0.95,1.0,1.06,1.12,1.18,1.24,1.26][fi]；s.sx=1/pow(s.sy,0.8)；落地K(t,[[2.5,-0.44],[2.583,0.14,out2],[2.667,-0.05],[2.75,0]])。"
      },
      {
        "name": "火苗连续舞步",
        "value": "HOPS=[{t0:2.833,t1:3.0,h:120},{t0:3.333,t1:3.5,h:115},{t0:3.75,t1:4.0,h:175,spin:true}]。"
      },
      {
        "name": "重放总时长",
        "value": "10.033333333 秒"
      },
      {
        "name": "落滴压扁飞溅参数",
        "value": "const G = 5000;                              // gravity px/s^2 (droplets, leaps, drips)\n  const svLand = (d, tl) => { const s = 1.3 + (SV_PUD - 1.3) * spring(tl + 1.3 / 30, 6, d.z); return s < SV_PUD ? SV_PUD - (SV_PUD - s) * 0.45 : s; };\n  const TEN_T = 0.27;\n        r: rr(3.5, big ? 8 : 6), u: d.u + rr(-0.05, 0.05), tEmit: d.tLand + 2 / 30 + rr(0, 1 / 30), tGrow: 0.03, owner: di, melt, fy: rr(-36, 30),"
      }
    ],
