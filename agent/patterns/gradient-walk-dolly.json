  "pattern": {
    "id": "gradient-walk-dolly",
    "order": 101,
    "title": "沿梯度横移长镜",
    "types": [
      "camera",
      "composition"
    ],
    "carriers": [
      "video"
    ],
    "orients": [
      "landscape"
    ],
    "summary": "把降雨量映射为横向距离，单调分段相机穿过五区，四层视差与区域混色随数据变化。",
    "mechanism": "RAINK 给世界坐标对应雨量，rainAt 在量级间做对数插值；camXf 用 monotone 连续横移，LAY 派生各层位置，mixZone / zoneGrad 随区域混色，事件附近的相机键减小速度。",
    "trigger": "刷边揭景完成，相机从红色腹地向绿色海岸前进。",
    "effect": "观众用连续路程读出一个测量梯度，并在火、王桉和雨林处获得停留。",
    "timing": [
      {
        "name": "来源片段",
        "value": "10.3–70.3 秒；长镜头至 73 秒抵达世界 x=9800。"
      },
      {
        "name": "事件减速",
        "value": "film/scene.js:camXf：41→45 秒 x=5500→5850；54→58.5 秒 x=7300→7550。"
      }
    ],
    "parameters": [
      {
        "name": "连续横移",
        "value": "film/scene.js:camXf；film/engine.js:monotone：Fritsch–Carlson 单调三次插值；10.3 秒 x700，73 秒 x9800。"
      },
      {
        "name": "四层视差",
        "value": "film/scene.js:LAY：par=.25/.55/1/1.55；scale=.38/.62/1/1.75；alpha=.5/.78/1/.95。"
      },
      {
        "name": "数值与色板",
        "value": "film/scene.js:RAINK / rainAt / ZCOL / mixZone：雨量约 150–4000mm，经 log / exp 插值；地表与天空按区域位置混色。"
      }
    ],
    "sourceFiles": [
      "demos/cases/lemo-watercolor/film/scene.js",
      "demos/cases/lemo-watercolor/film/engine.js"
    ],
    "locator": "camXf / LAY / RAINK / rainAt / ZCOL / mixZone / zoneGrad",
    "useCases": [
      "观众用连续路程读出一个测量梯度，并在火、王桉和雨林处获得停留。"
