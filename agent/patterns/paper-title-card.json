    "summary": "衬线大字逐词入场，星号标出的强调词用琥珀斜体，可挂里程表数字子标，作为功能段之间的呼吸位。",
    "mechanism": "TITLE_CARDS 文案用 *词* 标强调，parseWords 解析后逐词入场；强调词琥珀色斜体；card2 带副标与 DigitRoll 逐位滚动数字。",
    "trigger": "功能段之间的硬切处，进入时配 swoosh。",
    "effect": "节奏从高能镜头落回低位，给下一段留呼吸。",
    "timing": [
      {
        "name": "片段",
        "value": "AIFL_SHOTS.card2：565–620 帧，55/30 秒。"
      },
      {
        "name": "逐词",
        "value": "delay=4+i*4；每词 delay→delay+9；本张 7 词，最后一词 37 帧落定。"
      },
      {
        "name": "副标与退出",
        "value": "subT=10→22；DigitRoll delay=12、滚动 22 帧；underline=16→34；fadeOut=duration-8→duration，即 47→55。"
      }
    ],
    "parameters": [
      {
        "name": "字形",
        "value": "fontSize=116；ink=#13110f，accent=#955905；强调词 italic；字体 ui-serif,Georgia。"
      },
      {
        "name": "入场",
        "value": "bezier(0.2,0.75,0.3,1)；scale=1.28-0.28*t；blur=(1-t)*7px。"
      },
      {
        "name": "数字",
        "value": "offset=(10+target)*t*lineH；lineH=fontSize*1.15；bezier(0.25,0.8,0.25,1)。"
      }
    ],
    "sourceFiles": [
