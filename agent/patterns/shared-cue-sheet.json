      {
        "name": "扁平矢量落点",
        "value": "180、195、210、225帧；6、6.5、7、7.5秒。"
      },
      {
        "name": "包豪斯级联",
        "value": "120BPM；R1=6、R2=6.5、R3=7.2、R4=7.5秒，8秒定格。"
      },
      {
        "name": "像素开箱节点",
        "value": "6秒震箱；6.2、6.3秒箱盖跳动；6.4秒开箱；6.8秒接物；7.2秒片名。"
      },
      {
        "name": "逐帧手绘节点",
        "value": "120BPM、24fps；6.5秒爆炸，7.25–8.5秒每0.125秒一笔。"
