  "pattern": {
    "id": "cel-line-boil",
    "order": 52,
    "title": "逐张重画：线条沸腾与换纸",
    "types": [
      "texture",
      "rhythm"
    ],
    "carriers": [
      "video"
    ],
    "orients": [
      "landscape",
      "portrait"
    ],
    "summary": "重放曝光表驱动的微差线稿循环、纸齿换位与尘点轮换，使停留形体与纸面持续重画。 综艺片按帧号替换照片贴图边缘，以耳朵四帧扭动和三张炸毛轮换形成动作。",
    "mechanism": "按曝光表一拍一、二、三取整绘制时间，循环噪声线稿变体让静止形体持续轻抖；同一绘制编号同时换纸齿采样区与尘点板。 综艺片按帧号替换照片贴图边缘，以耳朵四帧扭动和三张炸毛轮换形成动作。",
    "trigger": "时间进入下一张曝光画格时。",
    "effect": "线稿几何、纸齿位置与尘点板随绘制编号一起切换。",
    "timing": [
      {
        "name": "曝光表",
        "value": "SCHED=[[0,8,2],[8,24,1],[24,48,2],[48,60,1],[60,108,2],[108,120,3],[120,132,2],[132,168,1],[168,224,2],[224,230,1],[230,240,3]]；24fps。"
      },
      {
        "name": "线稿变体",
        "value": "bv=(D)=>(D.step===3?D.id%3:D.id%4)；boil(pts,seed,amp=2.4,scale=70)；z=seed*2.371+0.5。"
      },
      {
        "name": "纸齿换位",
        "value": "ox=floor(hs(v,51)*470)；oy=floor(hs(v,52)*310)；globalCompositeOperation=multiply；globalAlpha=0.5。"
      },
      {
        "name": "尘点轮换",
        "value": "IMG.dust[v%4]；globalAlpha=0.22；按v%2、v%3翻转。"
      },
      {
        "name": "重放时长",
        "value": "原片0–10秒，巧思总时长12.701秒。"
      },
      {
        "name": "追加原片区间",
        "value": "mg-hanazi 原片 1.3–1.834 秒；mg-hanazi 原片 5.8–7.967 秒；['e11', 'e16', 'e11', 'e6'][ef]\nconst pick = fm >= 0 && fm < 2 ? 'hL135' : (fm >= 2 && fm < 4) || (fd >= 2 && fd < 4) ? 'hL12' : fd < 2 ? 'hL06' : 'hB' + (Math.floor(tt * 12) % 3);"
      }
    ],
    "useCases": [
