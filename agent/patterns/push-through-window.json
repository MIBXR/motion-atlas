      },
      {
        "name": "连通推进",
        "value": "90/30–105/30=3.000–3.500秒；S1=1920/64=30；NP=2.2；s=exp(lerp(log(1.12),log(30),p))。"
      },
      {
        "name": "过冲弹定",
        "value": "105/30–115/30=3.500–3.833秒；OB=1.2；kA=NP/(tg-tp)，kB=(OB+3)/(tS-tg)，PG=(kB+A0*kA)/(kA+kB)。"
      },
      {
        "name": "放射速度条",
        "value": "22条；f0=102+i%3；各持续2帧；ra=r0+320*u；len=200+rng*300。"
      },
      {
        "name": "穿窗闪白",
        "value": "fr===105；fill=#FFF6E9；持续1/30=.033秒。"
      },
      {
        "name": "到达镜震",
        "value": "112帧s*=1.03、cy-=9/s；113帧s*=.988、cx+=7/s。"
      },
      {
        "name": "室内续推",
        "value": "115/30–160/30=3.833–5.333秒；s*=1+.14*w；cx=P.x+100/S1*w；cy=P.y-40/S1*w。"
      }
    ],
