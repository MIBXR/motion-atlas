    "summary": "串联单各行按拍在竖向遮罩中翻入，回顾时同一列表逐行打勾；报道的分类签、标题条和来源行与所属画面一起在带状转场裁切区内绘制，新旧文字在同一帧交接。",
    "mechanism": "串联单各行按拍在竖向遮罩中翻入，回顾时同一列表逐行打勾；报道的分类签、标题条和来源行与所属画面一起在带状转场裁切区内绘制，新旧文字在同一帧交接。",
    "trigger": "开场列出四条报道、报道换镜及片尾回顾。",
    "effect": "用稳定节目包装标明当前议题，并让串联单的内容和完成状态形成呼应。",
    "timing": [
      {
        "name": "原片重放区间",
        "value": "1.5–9秒；23.7–24.3秒；45–47.5秒；1倍速，总时长10.6秒。"
      }
    ],
    "parameters": [
      {
        "name": "串联单",
        "value": "film/main.js:rundown；四行2.3/2.7/3.1/3.5秒翻入，回顾45.8/46.2/46.6/47.0秒打勾。"
      },
      {
        "name": "标题条",
        "value": "film/main.js:strap；x=96，y=904，宽1250、高104，分类签y=856，中文50px、英文27px。"
      },
      {
        "name": "随图交接",
        "value": "film/main.js:layer / wipe；WIPES各侧通过layer先绘制自己的strap、credit、cornerTag，再由带状遮罩交接。"
      }
    ],
    "sourceFiles": [
