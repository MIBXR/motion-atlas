    "id": "list-stack-press",
    "order": 95,
    "title": "列表堆叠压入",
    "types": [
      "composition",
      "feedback"
    ],
    "carriers": [
      "video"
    ],
    "orients": [
      "landscape"
    ],
    "summary": "论文列表逐条堆叠压入页面，计数器随之滚动落定。",
    "mechanism": "五张论文卡按 CUES=[18,30,42,54,66] 的顺序从下方 600px 飞入，各用 22 帧带超调压实；后续卡片进入时，已落位列表在 cue、cue+4、cue+8 帧下压 0、6、0px，计数器按 frame>=cue+22 更新并由 DigitRoll 落定。",
    "trigger": "字卡二结束后切入列表页。",
    "effect": "列表一条条压实，数字落定在最后一条之后。",
    "timing": [
      {
        "name": "片段",
        "value": "AIFL_SHOTS.chart：620–725 帧，105/30 秒。"
      },
      {
        "name": "堆叠",
        "value": "CUES=[18,30,42,54,66]；DUR=22；最后一条在 88 帧落位。"
      },
      {
        "name": "压入与收束",
        "value": "stackPress：[cue,cue+4,cue+8]→[0,6,0]；glazeVis 在 81,86,92,95 帧取 0,1,1,0。"
      }
    ],
    "parameters": [
      {
        "name": "入场姿态",
        "value": "dy=600*(1-t)+stackPress(i)；scale=1.06-0.06*t；TILTS=[2,-2,2,-2,2]。"
      },
      {
        "name": "缓动",
        "value": "FLY_EASE=Easing.bezier(0.45,0.05,0.25,1.12)。"
      },
      {
        "name": "计数",
        "value": "landedCount=CUES.filter(c=>frame>=c+DUR).length；DigitRoll(value=String(landedCount))。"
      }
    ],
    "sourceFiles": [
      "demos/cases/ink-press/film/src/aifl/live/ScenePapers.tsx"
    ],
    "locator": "ScenePapers / CUES / stackPress / landedCount",
    "accessibility": {
