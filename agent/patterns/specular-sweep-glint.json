        "value": "mg-synthwave 原片 4.75–5.85 秒；mg-synthwave 原片 7.925–9.8 秒；mg-liquid 原片 6.9–8 秒；1 倍速，总时长 4.075 秒。"
      },
      {
        "name": "镀铬斜扫星芒参数",
        "value": "    float b1 = (x - uGlint) / .09, b2 = (x - uGlint + .22) / .03;\n    float band = exp(-b1*b1) * .75 + exp(-b2*b2) * .45;\n  const gs = (tc, x, y, dur, r) => { const k = (t - (tc - dur / 2)) / dur; if (k > 0 && k < 1) glints.push({ x, y, r: r * Math.sin(Math.PI * k), a: Math.sin(Math.PI * k), rot: k * .8 }); };\n  gs(CUES.glint_star, TITLE_LEFT + TB.tw / TS * .085, TITLE_TOP + 6, .5, 150);"
      },
      {
        "name": "厚液斜向扫光参数",
        "value": "    S.key = { x: -0.78 + 0.06 * Math.sin(t * 0.6) + 0.30 * kd, y: -0.95 + 0.12 * kd,\n      glint: glint1 ? lerp(-900, 1700, inOut(inv(cues.glint - 0.1, cues.glint + 0.75, t))) : lerp(-300, 1900, inOut(g2)),\n  float gb = (p.x*0.8 - p.y*0.6) - uKey.z;\n  col += vec3(1.0,0.95,0.98)*uKey.w*exp(-gb*gb/(2.0*34.0*34.0))*ss(0.35,0.75,side)*(1.0-ss(0.9,1.0,side))*1.1;"
      }
    ],
