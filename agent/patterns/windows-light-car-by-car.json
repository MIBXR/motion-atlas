  "id": "windows-light-car-by-car",
  "pattern": {
    "id": "windows-light-car-by-car",
    "order": 122,
    "title": "车窗逐节亮灭",
    "types": [
      "rhythm",
      "sound",
      "composition"
    ],
    "carriers": [
      "video"
    ],
    "orients": [
      "landscape"
    ],
    "summary": "机车与七节车厢各自控制车窗glow map，开场从车头起逐节点亮并配同拍上行钟琴；到终点按同一车厢顺序熄灭，钟琴音高倒序下行，最后保留站灯。",
    "mechanism": "机车与七节车厢各自控制车窗glow map，开场从车头起逐节点亮并配同拍上行钟琴；到终点按同一车厢顺序熄灭，钟琴音高倒序下行，最后保留站灯。",
    "trigger": "开场1.5秒开始亮窗，终点42秒开始灭窗。",
    "effect": "同一组灯与音符的升降镜像让出发和告别相互呼应。",
    "timing": [
      {
        "name": "原片重放区间",
        "value": "0.4–5.25秒；41–46.5秒；1倍速，共10.350000秒。"
      }
    ],
    "parameters": [
      {
        "name": "八节车厢亮灯",
        "value": "film/timeline.json:HIT.cars=1.5+.34*i，i=0…7；film/src/world.js:world.update对每个cars[i]设置uGlowLit=ss(seg(t,H.cars[i],H.cars[i]+.12))*(1+.03*sin(9*t+2*i))。"
      },
      {
        "name": "到站灭灯",
        "value": "film/timeline.json:HIT.off=[42,42.42,42.84,43.26,43.68,44.1,44.52,45.75]；film/src/shots.js:s6.update用1-ss(seg(t,H.off[i],H.off[i]+.18))逐节熄灭，站灯保留。"
      },
      {
        "name": "音符镜像",
        "value": "source/mix.py:UP=[D5,E5,F#5,A5,B5,D6,E6,F#6]；H.cars读取UP[k]，H.off读取UP[::-1][k]，每事件一声glockenspiel，共用timeline.json。"
      },
      {
        "name": "十二钟逐字亮灯",
        "value": "lemo-art-deco：film/timeline.js:12–14的strike(k)=35.86+(k−1)*60/116；film/scenes/roof.js、engine/bulbs.js的litSequence按十二个STRIKES点亮THE STARLIGHT十二字母，source/music/score.py同拍tubular_bells。"
      }
    ],
    "sourceFiles": [
      "demos/cases/lemo-paper-lantern/film/timeline.json",
      "demos/cases/lemo-paper-lantern/film/src/world.js",
      "demos/cases/lemo-paper-lantern/film/src/shots.js",
      "demos/cases/lemo-paper-lantern/source/mix.py"
    ],
    "locator": "HIT.cars / HIT.off / uGlowLit / UP",
    "useCases": [
      "用可数的光与音符组织出发和告别"
    ],
    "avoid": [],
    "accessibility": {
      "reducedMotion": "减少动态时暂停在预览时刻，声音默认关闭，可手动播放和定位。",
