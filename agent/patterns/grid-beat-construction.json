  "pattern": {
    "id": "grid-beat-construction",
    "order": 44,
    "title": "网格逐拍构成",
    "types": [
      "composition",
      "rhythm",
      "hud"
    ],
    "carriers": [
      "video"
    ],
    "orients": [
      "landscape"
    ],
    "summary": "在网格上逐拍落下几何，反拍准星预示落点，拍数随节拍跳变。",
    "mechanism": "在120px网格上按120BPM逐拍落下几何，反拍预示落点，拍数计数逐拍跳变。",
    "trigger": "原片网格线对、几何落点、反拍准星与拍点节点依次到达。",
    "effect": "网格从中心轴向外画开，红圆加速落位再滑入接触点，准星被落印覆盖，拍数逐拍累积。",
    "timing": [
      {
        "name": "网格",
        "value": "M=120；Y0=60；15条竖线、9条横线；L=land0+d*step；land0=0.125，step=0.125，draw=0.25；io2。"
      },
      {
        "name": "拍数",
        "value": "每拍0.5秒；n=clamp(floor(snap(t)/cues.beat+1e-6)+1,1,20)；padStart(2,\"0\")。"
      },
      {
        "name": "圆形落位",
        "value": "u=prog(t,-0.2,0.5)^2；dx=(1-u)*6*M；圆心(840+dx,300-M*(1-sl))，r=240。"
      },
      {
        "name": "反拍准星",
        "value": "target1：1.25–1.5秒；target2：1.75–2秒；target3：2.25–2.5秒；target4：2.75–3秒；环半径21–25，中心点半径4，十字短线32×4。"
      },
      {
        "name": "一格接触",
        "value": "sl=io2(prog(t,2.75,3))；圆心局部y=300-120*(1-sl)。"
      }
    ],
    "useCases": [
      "按节拍逐项搭建的几何构成",
      "网格动态海报"
    ],
    "avoid": [],
    "accessibility": {
      "reducedMotion": "减少动态时暂停在预览时刻，可手动播放和定位。",
      "keyboard": "空格播放或暂停，左右方向键定位，Shift加方向键跳到标记。"
    },
