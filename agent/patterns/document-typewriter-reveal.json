    "summary": "周报页在键盘声里自己写出来，随后历史周报逐条弹入侧栏，每落一条配一个 pop。",
    "mechanism": "正文两块一组按 cueFor(i)=6+floor(i/2)*3.5 推进，纸遮罩向右收缩，琥珀光标跟随最新揭示边缘；侧栏 6 次弹入对应 SFX 中 pop 帧 840–865、每 5 帧一次，音量从 0.4 每次降 0.03。",
    "trigger": "字卡三结束后切入周报页，键盘音同时开始。",
    "effect": "文档像被实时写出，侧栏的历史条目一下下落位。",
    "timing": [
      {
        "name": "片段",
        "value": "AIFL_SHOTS.wbr：775–885 帧，110/30 秒。"
      },
      {
        "name": "正文揭示",
        "value": "cueFor(i)=6+floor(i/2)*3.5，WIPE=8；20 块正文的最后一组在 45.5 帧完成。"
      },
      {
        "name": "侧栏与声音",
        "value": "左栏 46→56、右栏 54→64；WEEK_CUE(i)=58+i*5，8 帧弹入；pop 绝对帧 840,845,850,855,860,865，volume=0.4-0.03*i。"
      }
    ],
    "parameters": [
      {
        "name": "揭示缓动",
        "value": "REVEAL_EASE=Easing.bezier(0.4,0,0.6,1)；遮罩 width=coverT*100%，right=0。"
      },
      {
        "name": "历史条目",
        "value": "6 条；WEEK_Y0=228，WEEK_H=56，translateY=-44*(1-t)；WEEK_DROP=bezier(0.2,1.15,0.3,1)。"
      },
      {
        "name": "键盘声",
        "value": "SFX：from=781，volume=0.34；sfxDuration=44 帧。"
      }
    ],
    "sourceFiles": [
      "demos/cases/ink-press/film/src/aifl/live/SceneWbr.tsx"
    ],
    "locator": "SceneWbr / cueFor / WEEK_CUE / WEEK_DROP；Main.SFX",
