    "summary": "把河流和电力路径画成板上走线，按路径弧长推进光；交流短划线来回摇摆，直流由单向光头、连续光流和余辉组成，换流器的内部边缘在转换时发光。",
    "mechanism": "把河流和电力路径画成板上走线，按路径弧长推进光；交流短划线来回摇摆，直流由单向光头、连续光流和余辉组成，换流器的内部边缘在转换时发光。",
    "trigger": "来源案例时间轴进入所列动作区间。",
    "effect": "把河流和电力路径画成板上走线，按路径弧长推进光；交流短划线来回摇摆，直流由单向光头、连续光流和余辉组成，换流器的内部边缘在转换时发光。",
    "timing": [
      {
        "name": "原片重放区间",
        "value": "4.700000–10.100000秒；14.400000–23.500000秒；38.400000–41.500000秒；1倍速，总时长17.600000秒。"
      }
    ],
    "parameters": [
      {
        "name": "交流",
        "value": "film/src/main.js:acPhase / sceneCorridor：5.4–10.1秒的相位按.55Hz变化，近景lam=8、amp=.42；film/src/render.js负责沿trace绘光。"
      },
      {
        "name": "直流",
        "value": "film/src/main.js:headS / sceneCorridor：16.5–23秒到终点；dcp/dcn双线，decay=520、floor=.7、v=200、minPx=6.5；23秒后decay=2000。"
      },
      {
        "name": "充电器",
        "value": "film/src/main.js:sceneCharger：T_DB=39.4，交流pL/L/L2→plus/minus/pri/sec/vbus单向光流。"
      }
    ],
    "sourceFiles": [
