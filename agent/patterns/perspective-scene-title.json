{
  "schemaVersion": 1,
  "kind": "pattern",
  "id": "perspective-scene-title",
  "pattern": {
    "id": "perspective-scene-title",
    "order": 179,
    "title": "透视场次标题",
    "types": [
      "type-motion",
      "composition"
    ],
    "carriers": [
      "video"
    ],
    "orients": [
      "landscape"
    ],
    "summary": "场次与调名两组字各在一张透视平面上，外侧大、向中央收拢，每组共用一条单应轨迹；字形投影后填充，音符与网格叠在上面。",
    "mechanism": "每个标题镜头（shots.giants）含两组文字：场次（第二場）与调名（ニ長調），每组带一条逐帧的 3×3 单应轨迹（homography）。字形轮廓取自 titleGlyphs（Noto Sans JP 900，190px），每个轮廓点以 (u,v)=(x+dx, baseline+dy) 经 w=m6·u+m7·v+m8、x=(m0·u+m1·v+m2)/w、y=(m3·u+m4·v+m5)/w 投影，再用 fillRule 填充，所以一组字内共用同一平面，不会出现各字独立变形。两组矩阵的透视项符号相反（21.7 秒 m6=0.000766 与 −0.00052），于是两组字外侧大、向中央收拢。标题先于乐谱绘制，音符、网格与播放线叠在字面之上；字形的 opacity 曲线单独控制淡入淡出。",
    "trigger": "转调之后的场次切换：第二場 20.033 秒、第三場 43.6 秒、第四場 81.15 秒。",
    "effect": "整幅巨字压在总谱下方：第二場为不透明白字压在红底上，第三場为透明度 0.16 的红字压在白底上；音符与网格仍从字面上穿过，随后标题淡出。",
    "timing": [
      {
        "name": "原片重放区间",
        "value": "butterfly-garden-score：20.03–23.55秒；butterfly-garden-score：43.6–47.33秒；1倍速，总时长7.25秒。"
      },
      {
        "name": "标题镜头",
        "value": "giants[0] 20.033–23.55 秒白字；giants[1] 43.6–47.333 秒红字；giants[2] 81.15–84.917 秒红字。"
      }
    ],
    "parameters": [
      {
        "name": "单应轨迹",
        "value": "butterfly-garden-score film/data/shots.json:giants[].groups[].homography，两组各 107（第二場）或 113（第三場）个采样；第二場 21.7 秒场次组 [1.539466,0,265.772,0.414004,1.233647,313.576,0.000766,0,1]，调名组 [0.134870,0,938.131,−0.280410,0.840538,385.663,−0.000520,0,1]。"
      },
      {
        "name": "字形与排版",
        "value": "butterfly-garden-score film/data/titleGlyphs.json 与 shots.json:giants[].groups[]，fontSize 190、baseline 260、字 x 为 20/210/400；fillRule nonzero。"
      },
      {
        "name": "透明度",
        "value": "butterfly-garden-score film/data/shots.json:giants[].groups[].glyphs[].opacity，第二場 20.03–22.9 秒为 1，至 23.55 秒淡出；第三場 43.7–47 秒为 0.16，至 47.3 秒淡出。"
      },
      {
        "name": "投影填充",
        "value": "butterfly-garden-score film/scene.js:giants，逐轮廓点做单应投影后 ctx.fill(titleGlyphs.fillRule)，globalAlpha 取 g.opacity；先于 scoreRows 绘制。"
      }
    ],
    "sourceFiles": [
      "demos/cases/butterfly-garden-score/film/scene.js",
      "demos/cases/butterfly-garden-score/film/data/shots.json",
      "demos/cases/butterfly-garden-score/film/data/titleGlyphs.json"
    ],
    "locator": "butterfly-garden-score film/scene.js:giants；film/data/shots.json:giants",
    "useCases": [
      "章节、场次或调性切换时的巨型标题",
      "需要让标题有空间感又不遮住下层信息图的片段"
    ],
    "avoid": [
      "标题字数很多、投影后外侧字形过大会越出画幅",
      "下层内容必须清晰可读、不能被标题色块干扰的画面"
    ],
    "composition": {
      "role": "accent",
      "pairsWellWith": [
        "scrolling-score-timeline",
        "key-change-color-flip"
      ],
      "conflicts": [],
      "notes": "标题画在乐谱下层，音符与网格从字面上方穿过；标题颜色随底色取白或红（红底用白字，白底用红字）。"
    },
    "prompt": "用来源案例 butterfly-garden-score 的原作 renderAt(t) 重放“透视场次标题”。保留场次与调名两组字各一条逐帧单应轨迹、Noto Sans JP 900 字形轮廓逐点投影后填充、两组透视项符号相反使外侧大而向中央收拢，并先于乐谱绘制让音符与网格叠在字上。按 index.html 内联配置的 segments 定位 20.03–23.55、43.6–47.33 秒，复用原作数据、字体与同区间音轨，声音默认关闭。",
    "demo": "demos/patterns/perspective-scene-title/index.html",
    "kit": true,
    "timeline": true,
    "sources": [
