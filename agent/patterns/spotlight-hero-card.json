    "carriers": [
      "video"
    ],
    "orients": [
      "landscape"
    ],
    "summary": "暖色聚光在看板上游走后锁定一张卡，相机推近转到侧斜视角，卡片弹起悬浮、光束扫过再压缩归位。",
    "mechanism": "光池先在全景页面游走，锁定后收缩并压暗周围；相机 16 帧推近并以 rotY 为主转到左侧视角；卡片用带回弹的 POP_EASE 弹起悬浮，光束扫过表面，再用 RESEAT_EASE 压缩落回原位。",
    "trigger": "品牌字标溶解、看板全景出现后开始。",
    "effect": "观众视线从整页收束到一张卡，单主角走完一条完整动作弧。",
    "timing": [
      {
        "name": "片段",
        "value": "SceneOpen 的 82–220 帧，138/30 秒；以下帧号为场景帧。"
      },
      {
        "name": "聚光与推近",
        "value": "spotX/spotY 键=86,90,98,104,110,130；CAM_KEYS 在 114→130 帧完成推近。"
      },
      {
        "name": "卡片动作弧",
        "value": "rise=130→140；hover=140→194；beam1=142→156；beam2=162→182；reseat=194→212。"
      }
    ],
    "parameters": [
      {
        "name": "推近姿态",
        "value": "zoom=0.78→2.6，rotX=8°、rotY=34°、rotZ=2°、persp=1200。"
      },
      {
        "name": "弹起与归位",
        "value": "POP_EASE=Easing.bezier(0.2,1.25,0.3,1)；RESEAT_EASE=Easing.bezier(0.4,0,0.3,1.05)。"
      },
      {
        "name": "悬浮",
        "value": "z=110*lift+sin((frame-140)/40*2π)*4*lift；press 在 208,211,212 帧取 1,0.997,1。"
      }
    ],
    "sourceFiles": [
      "demos/cases/ink-press/film/src/aifl/live/SceneOpen.tsx"
    ],
    "locator": "SceneOpen / CAM_KEYS / POP_EASE / RESEAT_EASE",
    "accessibility": {
      "reducedMotion": "减少动态时暂停在预览时刻，可手动播放和定位。",
      "keyboard": "空格播放或暂停，左右方向键定位，Shift加方向键跳到标记。"
    },
    "composition": {
